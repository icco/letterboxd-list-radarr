{
    "name": "letterboxd-list-radarr",
    "version": "1.3.0",
    "description": "Convert Letterboxd-list to consumable data",
    "main": "index.js",
    "author": "Sebastian Langer <sl@scn.cx>",
    "homepage": "https://github.com/screeny05/letterboxd-list-radarr",
    "license": "MIT",
    "scripts": {
        "start": "node dist/index.js",
        "dev": "LOG_LEVEL=debug tsx --inspect=5858 index.ts",
        "watch": "nodemon --watch lib --watch index.ts -e js,ts --exec 'npm run dev'",
        "build": "tsc --outDir dist --skipLibCheck || exit 0",
        "test": "npm run build && node --test test/*.ts",
        "postinstall": "npm run build"
    },
    "dependencies": {
        "axios": "^1.20.0",
        "express": "^5.3.0",
        "kanpai-scraper": "^0.1.0",
        "p-limit": "^7.3.3",
        "read-package-up": "^12.0.0",
        "redis": "^6.3.0",
        "robots-parser": "^3.0.1",
        "typescript": "^7.0.2",
        "winston": "^3.19.0"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.5",
        "nodemon": "^3.1.14",
        "tsx": "^4.23.15"
    },
    "engines": {
        "node": ">=24.0.0"
    }
}
